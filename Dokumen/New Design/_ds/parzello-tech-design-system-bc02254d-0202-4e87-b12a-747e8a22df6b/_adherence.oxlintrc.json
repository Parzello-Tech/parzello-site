{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/post/**",
              "ui_kits/social-posts/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Helvetica Now Display|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Helvetica Now Display, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|magenta|glass|ghost)$/]",
        "message": "<Badge> tone must be one of 'purple' | 'magenta' | 'glass' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|topLight|radius|blur|padding|className|style|key|ref|className|style|children)$/]",
        "message": "<GlassCard> doesn't accept that prop. Declared props: children, topLight, radius, blur, padding, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassCard'] > JSXAttribute[name.name='topLight'] > Literal[value!=/^(?:white|purple|none)$/]",
        "message": "<GlassCard> topLight must be one of 'white' | 'purple' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|markSrc|wordColor|className|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, markSrc, wordColor, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark)$/]",
        "message": "<Logo> variant must be one of 'lockup' | 'mark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|as|size|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, as, size, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|span|button|a)$/]",
        "message": "<Pill> as must be one of 'div' | 'span' | 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Pill> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:glass|solid|magenta)$/]",
        "message": "<Pill> tone must be one of 'glass' | 'solid' | 'magenta'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|aurora|margin|header|footer|children|className|style|key|ref|className|style|children)$/]",
        "message": "<PostCanvas> doesn't accept that prop. Declared props: width, height, aurora, margin, header, footer, children, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:left|right|showLeft|showRight|className|style|key|ref|className|style|children)$/]",
        "message": "<PostFooter> doesn't accept that prop. Declared props: left, right, showLeft, showRight, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|markSrc|showLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<PostHeader> doesn't accept that prop. Declared props: label, markSrc, showLabel, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
